---
import "../styles/globals.css";
import "../styles/dashboard.css";
import Icon from "../components/dashboard/Icon.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { dashboardNav, navGroups, tenants, kpis } from "../data/dashboard";

interface Props {
  title: string;
  active: string; // current nav href, e.g. "/app"
  description?: string;
}
const { title, active, description = "Plynf control & monitoring dashboard." } = Astro.props;
const fullTitle = `${title} · Plynf Dashboard`;
// Control-plane API base. The dashboard fetches live state from the
// plinth_dashboard aggregator (:7424) at runtime; if unreachable it renders
// the bundled SSG data (offline demo). Override at build via PUBLIC_PLYNF_API.
const apiBase = import.meta.env.PUBLIC_PLYNF_API || "http://localhost:7424";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#08070d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Theme + role bootstrap before paint (no flash) -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("plinth-theme");
          if (t === "light" || t === "dark")
            document.documentElement.setAttribute("data-theme", t);
        } catch (_) {}
      })();
    </script>

    <!-- Session guard: dashboard is gated. Demo mode lets ?demo=1 through. -->
    <script is:inline>
      (function () {
        try {
          var url = new URL(window.location.href);
          // Accept a token arriving in the fragment (OAuth broker style).
          if (location.hash && location.hash.indexOf("token=") !== -1) {
            var tok = location.hash.split("token=")[1].split("&")[0];
            if (tok) {
              localStorage.setItem("plynf_session", tok);
              history.replaceState(null, "", url.pathname + url.search);
            }
          }
          if (url.searchParams.get("demo") === "1") {
            localStorage.setItem("plynf_session", "demo");
          }
          var session = localStorage.getItem("plynf_session");
          if (!session) {
            var next = encodeURIComponent(url.pathname);
            window.location.replace("/login?next=" + next);
          }
        } catch (_) {}
      })();
    </script>
  </head>

  <body class="dash-bg" data-role="developer" data-api={apiBase} data-conn="connecting">
    <div class="dash-grid">
      <!-- ── Sidebar ─────────────────────────────────────── -->
      <aside class="dash-sidebar" id="dash-sidebar">
        <a href="/" class="flex items-center gap-2.5 px-2 py-1.5 mb-2" aria-label="Plynf home">
          <span class="relative flex h-7 w-7 items-center justify-center rounded-lg bg-bg-2 border border-border overflow-hidden">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <defs>
                <linearGradient id="db-rock" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#ff8551" />
                  <stop offset="50%" stop-color="#d946ef" />
                  <stop offset="100%" stop-color="#6366f1" />
                </linearGradient>
              </defs>
              <path d="M5 17 L8 9 L12 6 L17 6 L20 11 L20 17 Z" fill="url(#db-rock)" stroke="#1d1f29" stroke-width="0.6" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="font-semibold tracking-tight text-ink-primary text-[15px]">Plynf</span>
          <span class="dbadge dbadge-accent ml-auto !text-[0.6rem]">app</span>
        </a>

        <!-- Tenant switcher -->
        <button class="dash-navlink mb-1 w-full" id="tenant-switch" aria-haspopup="listbox">
          <span class="dot dot-healthy"></span>
          <span class="flex-1 text-left">
            <span class="block text-ink-primary text-[0.82rem] leading-tight" id="tenant-name">{tenants[0].name}</span>
            <span class="block text-2xs text-ink-muted mono">{tenants[0].isolation} · {tenants[0].region}</span>
          </span>
          <Icon name="chevron" size={15} />
        </button>

        <nav class="flex flex-col gap-0.5 mt-1 overflow-y-auto" aria-label="Dashboard">
          {navGroups.map((group) => (
            <div class="mt-2 first:mt-1">
              <div class="px-2.5 pb-1 text-[0.62rem] mono uppercase tracking-[0.14em] text-ink-muted">{group.label}</div>
              {dashboardNav.filter((i) => i.group === group.id).map((item) => (
                <a href={item.href} class="dash-navlink" aria-current={item.href === active ? "page" : undefined}>
                  <Icon name={item.icon} />
                  <span class="flex-1">{item.label}</span>
                  {item.badge ? <span class="dbadge dbadge-bad !text-[0.65rem] !px-1.5 !py-0.5">{item.badge}</span> : null}
                </a>
              ))}
            </div>
          ))}
        </nav>

        <div class="mt-auto pt-3 border-t border-border">
          <a href="https://docs.plynf.com" class="dash-navlink"><Icon name="external" size={16} /><span>Docs</span></a>
          <button class="dash-navlink w-full" id="logout-btn"><Icon name="logout" size={16} /><span>Sign out</span></button>
          <div class="flex items-center gap-2.5 px-2.5 py-2 mt-1">
            <span class="h-7 w-7 rounded-full bg-gradient-to-br from-grad-orange to-grad-magenta grid place-items-center text-[0.7rem] font-semibold text-[#190612]">LH</span>
            <span class="flex-1 min-w-0">
              <span class="block text-[0.8rem] text-ink-primary truncate">Lena Hofer</span>
              <span class="block text-2xs text-ink-muted truncate">Owner · acme</span>
            </span>
          </div>
        </div>
      </aside>

      <!-- ── Main column ─────────────────────────────────── -->
      <div class="min-w-0">
        <header class="dash-topbar">
          <div class="flex items-center gap-3 min-w-0">
            <button class="btn btn-ghost h-9 w-9 !p-0 md:hidden" id="menu-btn" aria-label="Open navigation">
              <Icon name="menu" size={18} />
            </button>
            <h1 class="text-[0.95rem] font-semibold text-ink-primary truncate">{title}</h1>
          </div>

          <div class="flex items-center gap-2">
            <!-- Role toggle: re-weights the whole dashboard per persona -->
            <div class="segmented hidden sm:inline-flex" role="group" aria-label="View as role" id="role-toggle">
              <button data-role="developer" aria-pressed="true">Developer</button>
              <button data-role="lead" aria-pressed="false">Lead</button>
              <button data-role="finance" aria-pressed="false">Finance</button>
              <button data-role="security" aria-pressed="false">Security</button>
            </div>

            <span id="conn-badge" class="dbadge !hidden sm:!inline-flex" title="Backend connection">
              <span class="dot dot-paused !w-2 !h-2"></span><span id="conn-label">offline</span>
            </span>
            <button class="btn btn-ghost h-9 w-9 !p-0 relative" aria-label="Alerts">
              <Icon name="bell" size={17} />
              {kpis.alertsCount > 0 && (
                <span class="absolute top-1.5 right-1.5 h-2 w-2 rounded-full bg-[#f4566f] ring-2 ring-bg-0"></span>
              )}
            </button>
            <ThemeToggle />
          </div>
        </header>

        <!-- Mobile role toggle -->
        <div class="sm:hidden px-4 pt-3">
          <div class="segmented w-full justify-between" role="group" aria-label="View as role" id="role-toggle-m">
            <button data-role="developer" aria-pressed="true">Dev</button>
            <button data-role="lead" aria-pressed="false">Lead</button>
            <button data-role="finance" aria-pressed="false">Finance</button>
            <button data-role="security" aria-pressed="false">Security</button>
          </div>
        </div>

        <main class="dash-main mx-auto">
          <slot />
        </main>
      </div>
    </div>

    <!-- Mobile sidebar backdrop -->
    <div id="sidebar-backdrop" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm hidden md:!hidden"></div>

    <!-- Toast host -->
    <div id="toast-host" aria-live="polite"></div>

    <slot name="modals" />

    <script is:inline>
      (function () {
        // ── Reveal-on-scroll (data-reveal → .is-visible). Without this the
        //    dashboard cards stay at opacity:0 (rule lives in globals.css). ──
        var reveals = document.querySelectorAll("[data-reveal]");
        if (typeof IntersectionObserver === "undefined") {
          reveals.forEach(function (el) { el.classList.add("is-visible"); });
        } else {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) { e.target.classList.add("is-visible"); io.unobserve(e.target); }
            });
          }, { threshold: 0.08, rootMargin: "0px 0px -4% 0px" });
          reveals.forEach(function (el) { io.observe(el); });
        }

        // ── Role toggle (persisted, drives [data-role] on <body>) ──
        function applyRole(role) {
          document.body.setAttribute("data-role", role);
          try { localStorage.setItem("plynf-role", role); } catch (_) {}
          document.querySelectorAll("#role-toggle button, #role-toggle-m button").forEach(function (b) {
            b.setAttribute("aria-pressed", b.getAttribute("data-role") === role ? "true" : "false");
          });
        }
        try {
          var saved = localStorage.getItem("plynf-role");
          if (saved) applyRole(saved);
        } catch (_) {}
        document.querySelectorAll("#role-toggle button, #role-toggle-m button").forEach(function (b) {
          b.addEventListener("click", function () { applyRole(b.getAttribute("data-role")); });
        });

        // ── Mobile sidebar ──
        var sidebar = document.getElementById("dash-sidebar");
        var menuBtn = document.getElementById("menu-btn");
        var backdrop = document.getElementById("sidebar-backdrop");
        function openNav(open) {
          if (!sidebar) return;
          sidebar.setAttribute("data-open", open ? "true" : "false");
          if (backdrop) backdrop.classList.toggle("hidden", !open);
        }
        menuBtn && menuBtn.addEventListener("click", function () { openNav(true); });
        backdrop && backdrop.addEventListener("click", function () { openNav(false); });

        // ── Sign out ──
        var logout = document.getElementById("logout-btn");
        logout && logout.addEventListener("click", function () {
          try { localStorage.removeItem("plynf_session"); } catch (_) {}
          window.location.href = "/login";
        });

        // Copy buttons are handled by the delegated click listener below
        // (so dynamically re-rendered rows with [data-copy] work too).

        // ── Toasts (transient confirmation for control actions) ──
        var host = document.getElementById("toast-host");
        window.plynfToast = function (msg) {
          if (!host) return;
          var t = document.createElement("div");
          t.className = "toast";
          t.innerHTML = '<span class="dot" style="width:8px;height:8px"></span>';
          t.appendChild(document.createTextNode(msg));
          host.appendChild(t);
          setTimeout(function () {
            t.style.transition = "opacity .3s, transform .3s";
            t.style.opacity = "0"; t.style.transform = "translateY(8px)";
            setTimeout(function () { t.remove(); }, 320);
          }, 2600);
        };

        // ── Modals: [data-modal-open="id"] opens #modal-<id>; [data-modal-close] / backdrop / Esc close ──
        function setModal(id, open) {
          var m = document.getElementById("modal-" + id);
          if (m) m.setAttribute("data-open", open ? "true" : "false");
        }
        document.querySelectorAll("[data-modal-open]").forEach(function (b) {
          b.addEventListener("click", function () { setModal(b.getAttribute("data-modal-open"), true); });
        });
        document.querySelectorAll(".modal-backdrop").forEach(function (bd) {
          bd.addEventListener("click", function (e) { if (e.target === bd) bd.setAttribute("data-open", "false"); });
          bd.querySelectorAll("[data-modal-close]").forEach(function (c) {
            c.addEventListener("click", function () { bd.setAttribute("data-open", "false"); });
          });
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape") document.querySelectorAll('.modal-backdrop[data-open="true"]').forEach(function (bd) { bd.setAttribute("data-open", "false"); });
        });

        // ── Live backend wire ───────────────────────────────────────────
        // The dashboard fetches live state from the plinth_dashboard
        // aggregator and POSTs control actions to it. Empty base = same-origin
        // (relative), so a reverse-proxied prod deploy satisfies CSP 'self'.
        var API = (document.body.getAttribute("data-api") || "").replace(/\/$/, "");
        function apiCall(method, path, body) {
          var headers = {};
          if (body) headers["Content-Type"] = "application/json";
          var session = null;
          try { session = localStorage.getItem("plynf_session"); } catch (_) {}
          if (session) headers["Authorization"] = "Bearer " + session;
          return fetch(API + path, {
            method: method,
            headers: headers,
            body: body ? JSON.stringify(body) : undefined,
          }).then(function (r) {
            if (r.status === 401) {
              // Session expired/invalid → bounce back to login.
              try { localStorage.removeItem("plynf_session"); } catch (_) {}
              window.location.replace("/login?next=" + encodeURIComponent(location.pathname));
              throw new Error("unauthenticated");
            }
            return r.json().catch(function () { return {}; }).then(function (data) {
              if (!r.ok) throw new Error((data.error && data.error.message) || (method + " " + path));
              return data;
            });
          });
        }
        window.plynfApi = apiCall;

        // Shared UI helpers for live list re-render (used by section pages).
        var STATUS = {
          healthy: ["dbadge-ok", "dot-healthy", "Healthy"], connected: ["dbadge-ok", "dot-healthy", "Connected"],
          running: ["dbadge-ok", "dot-healthy", "Running"], completed: ["dbadge-ok", "dot-healthy", "Completed"],
          active: ["dbadge-ok", "dot-healthy", "Active"], paid: ["dbadge-ok", "dot-healthy", "Paid"],
          degraded: ["dbadge-warn", "dot-degraded", "Degraded"], "rotate-soon": ["dbadge-warn", "dot-degraded", "Rotate soon"],
          open: ["dbadge-warn", "dot-degraded", "Open"], queued: ["dbadge", "dot-paused", "Queued"],
          paused: ["dbadge", "dot-paused", "Paused"], down: ["dbadge-bad", "dot-down", "Down"],
          error: ["dbadge-bad", "dot-down", "Error"], failed: ["dbadge-bad", "dot-down", "Failed"],
          expired: ["dbadge-bad", "dot-down", "Expired"], recovered: ["dbadge-info", "dot-degraded", "Recovered"],
        };
        window.plynfUI = {
          esc: function (s) {
            return String(s == null ? "" : s).replace(/[&<>"]/g, function (c) {
              return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c];
            });
          },
          statusBadge: function (status, label) {
            var s = STATUS[status] || ["dbadge", "dot-paused", status];
            return '<span class="dbadge ' + s[0] + '"><span class="dot ' + s[1] + ' !w-2 !h-2"></span>' + window.plynfUI.esc(label || s[2]) + "</span>";
          },
        };

        // value formatters (mirror src/data/dashboard.ts)
        var FMT = {
          eur: function (n) { try { return new Intl.NumberFormat("en-US", { style: "currency", currency: "EUR" }).format(n); } catch (_) { return n; } },
          pct: function (n) { return (typeof n === "number" ? n.toFixed(1) : n) + "%"; },
          compact: function (n) { try { return new Intl.NumberFormat("en-US", { notation: "compact", maximumFractionDigits: 1 }).format(n); } catch (_) { return n; } },
          num: function (n) { try { return new Intl.NumberFormat("en-US").format(n); } catch (_) { return n; } },
          count: function (v) { return Array.isArray(v) ? v.length : v; },
          litres: function (n) { try { return new Intl.NumberFormat("en-US", { maximumFractionDigits: 0 }).format(n) + " L"; } catch (_) { return n + " L"; } },
          raw: function (n) { return String(n); },
        };
        window.plynfFmt = FMT; // exposed for section live-render scripts
        function resolvePath(obj, path) {
          return path.split(".").reduce(function (o, k) { return o == null ? undefined : o[k]; }, obj);
        }
        function updateBindings(state) {
          document.querySelectorAll("[data-bind]").forEach(function (el) {
            var v = resolvePath(state, el.getAttribute("data-bind"));
            if (v === undefined || v === null) return;
            el.textContent = (FMT[el.getAttribute("data-fmt") || "raw"] || FMT.raw)(v);
          });
        }
        function setConn(kind) {
          document.body.setAttribute("data-conn", kind);
          var badge = document.getElementById("conn-badge");
          var label = document.getElementById("conn-label");
          if (!badge) return;
          badge.classList.remove("!hidden");
          var dot = badge.querySelector(".dot");
          if (kind === "live") {
            if (label) label.textContent = "Live";
            badge.classList.add("dbadge-ok");
            if (dot) dot.className = "dot dot-healthy !w-2 !h-2";
          } else {
            if (label) label.textContent = "Demo data";
            badge.classList.remove("dbadge-ok");
            if (dot) dot.className = "dot dot-paused !w-2 !h-2";
          }
        }
        function loadState() {
          apiCall("GET", "/api/app/state")
            .then(function (state) {
              window.__PLYNF_LIVE = state;
              updateBindings(state);
              setConn("live");
              // Pages with live lists (e.g. Routing) re-render on this event.
              window.dispatchEvent(new CustomEvent("plynf:state", { detail: state }));
            })
            .catch(function () { setConn("demo"); });
        }
        window.plynfRefresh = loadState;
        loadState();

        function bodyFromEl(el) {
          var raw = el.getAttribute("data-api-body");
          if (!raw) return null;
          try { return JSON.parse(raw); } catch (_) { return {}; }
        }
        // "POST /api/app/x" → run it; on success toast server message + refresh,
        // on failure fall back to the optimistic data-action toast (offline).
        function runApi(spec, body, fallback) {
          var parts = spec.split(/\s+/);
          apiCall(parts[0], parts[1], body)
            .then(function (res) { window.plynfToast(res.message || fallback); if (API) loadState(); })
            .catch(function () { window.plynfToast(fallback); });
        }

        // ── Delegated clicks: toggles + action buttons. Delegation means
        //    dynamically re-rendered content (live lists) works without
        //    re-binding listeners. ──
        document.addEventListener("click", function (e) {
          var cp = e.target.closest && e.target.closest("[data-copy]");
          if (cp) {
            navigator.clipboard && navigator.clipboard.writeText(cp.getAttribute("data-copy") || "");
            cp.setAttribute("data-copied", "1");
            setTimeout(function () { cp.removeAttribute("data-copied"); }, 1400);
            return;
          }
          var sw = e.target.closest && e.target.closest(".toggle");
          if (sw) {
            var next = sw.getAttribute("aria-checked") !== "true";
            sw.setAttribute("aria-checked", next ? "true" : "false");
            var label = sw.getAttribute("data-label") || "Setting";
            var fb = label + (next ? " enabled" : " disabled");
            var tapi = sw.getAttribute("data-api");
            if (tapi) runApi(tapi, { enabled: next }, fb);
            else window.plynfToast(fb);
            return;
          }
          var el = e.target.closest && e.target.closest("[data-action]");
          if (!el || el.tagName === "FORM") return;
          if (el.tagName === "A" && !el.getAttribute("href")) e.preventDefault();
          var closeId = el.getAttribute("data-close-modal");
          if (closeId) setModal(closeId, false);
          var api = el.getAttribute("data-api");
          if (api) runApi(api, bodyFromEl(el), el.getAttribute("data-action"));
          else window.plynfToast(el.getAttribute("data-action"));
        });

        // ── Forms (optional data-api → POST the named fields) ──
        document.querySelectorAll("form[data-action]").forEach(function (f) {
          f.addEventListener("submit", function (e) {
            e.preventDefault();
            var closeId = f.getAttribute("data-close-modal");
            if (closeId) setModal(closeId, false);
            var api = f.getAttribute("data-api");
            if (api) {
              var body = {};
              new FormData(f).forEach(function (v, k) { body[k] = v; });
              runApi(api, body, f.getAttribute("data-action"));
            } else {
              window.plynfToast(f.getAttribute("data-action"));
            }
            try { f.reset(); } catch (_) {}
          });
        });
      })();
    </script>
  </body>
</html>
