---
interface Props {
  /** When rendered as a section on the home page, use a slightly tighter intro. */
  variant?: "section" | "page";
}
const { variant = "section" } = Astro.props;

// Cards + comparison rows come from the single source of truth in
// data/plans.ts, which mirrors the proxy's enforced tier_gate.py. Editing
// pricing here is impossible to get out of sync with what actually gates.
import { PLANS, FEATURES } from "../data/plans";

const tiers = PLANS.map((p) => ({
  ...p,
  rows: FEATURES.map((f) => [f.label, f.values[p.id]] as [string, string]),
}));
---

<section class={variant === "page" ? "section" : "section"} id="pricing">
  <div class="container-page" data-reveal>
    <div class="max-w-3xl">
      <p class="section-eyebrow">Pricing</p>
      <h2 class="section-title text-balance">
        Free to start. Pro for teams.
        <span class="text-ink-muted">Real numbers for enterprise.</span>
      </h2>
      <p class="section-subtitle">
        Apache 2.0 forever. Self-hosted is and will always be free. We gate on
        <span class="text-ink-primary">volume and features</span> — never on how
        you connect. Every integration type (proxy, MCP, SDK, no-code node,
        webhook) works on every tier, including Free.
      </p>
      <p class="mt-3 inline-flex items-center gap-2 text-2xs font-mono uppercase tracking-widest" style="color: var(--grad-magenta);">
        <span class="inline-block h-1.5 w-1.5 rounded-full" style="background: var(--grad-magenta);"></span>
        Cloud is in beta — Pro and Enterprise are confirmed-only today. Self-hosted available now.
        <a href="/roadmap" class="text-ink-muted hover:text-ink-primary underline underline-offset-4 decoration-border-strong normal-case tracking-normal">See roadmap →</a>
      </p>
    </div>

    <div class="mt-14 grid gap-5 lg:grid-cols-3">
      {
        tiers.map((tier) => (
          <div
            class={`card ${tier.accent ? "glow-card relative" : ""} p-7 sm:p-8 flex flex-col`}
          >
            {tier.accent && (
              <span
                aria-hidden="true"
                class="absolute -top-3 left-7 inline-flex items-center rounded-full bg-accent px-2.5 py-1 text-2xs font-mono uppercase tracking-widest text-[#190612]"
              >
                Recommended
              </span>
            )}
            <div>
              <h3 class="text-lg font-semibold text-ink-primary">{tier.name}</h3>
              <p class="mt-1.5 text-sm text-ink-secondary">{tier.blurb}</p>
            </div>
            <div class="mt-6 flex items-baseline gap-1.5">
              <span class={`font-semibold tracking-tightest ${tier.accent ? "gradient-text-accent" : "text-ink-primary"}`} style="font-size: 2.25rem; line-height: 1;">
                {tier.price}
              </span>
              <span class="text-sm text-ink-muted">/ {tier.cadence}</span>
            </div>
            <a
              href={tier.cta.href}
              class={`mt-6 btn ${tier.accent ? "btn-primary" : "btn-secondary"} justify-center`}
            >
              {tier.cta.label}
            </a>
            <ul class="mt-7 space-y-3.5 text-sm">
              {tier.rows.map(([k, v]) => (
                <li class="flex items-baseline justify-between gap-3 border-b border-border pb-3.5 last:border-0 last:pb-0">
                  <span class="text-ink-muted">{k}</span>
                  <span class={`font-medium text-right ${v === "None" || v === "n/a" || v === "—" ? "text-ink-muted" : "text-ink-primary"}`}>{v}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="mt-10 text-center text-sm text-ink-muted">
      Need something custom? <a href="mailto:hello@plynf.com" class="text-ink-secondary hover:text-ink-primary underline underline-offset-4 decoration-border-strong">Just ask</a>.
      All tiers run on identical core code. Apache 2.0, no proprietary forks.
    </p>
  </div>
</section>
