---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import PageHeader from "../../components/dashboard/PageHeader.astro";
import Kpi from "../../components/dashboard/Kpi.astro";
import StatusBadge from "../../components/dashboard/StatusBadge.astro";
import Icon from "../../components/dashboard/Icon.astro";
import { billing, savingsTotals, eur, pct, compact } from "../../data/dashboard";
import { PLANS, FEATURES, planFor } from "../../data/plans";

const tier = billing.tier;
const plan = planFor(tier);
const budget = billing.monthlyTokenBudget; // number | null (null = unlimited)
const used = billing.usedTokens;
const usagePct = budget ? (used / budget) * 100 : 0;
const usageProgClass = usagePct > 80 ? "prog-warn" : "prog-ok";
const tokensRemaining = budget ? Math.max(0, budget - used) : null;
const usageLabel = budget ? `${compact(used)} / ${compact(budget)} tokens` : `${compact(used)} tokens · unlimited`;

// What Plynf saves vs. the flat fee — the "pays for itself" story.
const coverageX = savingsTotals.savedMonthEur / billing.monthlyFeeEur;

// Gate rows (what's unlocked per plan) + the token-allowance label per plan.
const gatedFeatures = FEATURES.filter((f) => f.gate);
const tokenRow = FEATURES.find((f) => f.label === "Shaped tokens / mo");
---
<DashboardLayout title="Account & Billing" active="/app/billing">
  <PageHeader
    kicker="Account & Billing"
    title="Your plan, your usage, your savings"
    lead="One flat price per tier — no per-seat fees, no surprise overage. Your tier sets a monthly token budget and which features are unlocked; Plynf saves you far more than it costs."
  >
    <button slot="actions" class="btn btn-secondary !py-2" data-modal-open="budget"><Icon name="bell" size={15} />Budget alert</button>
    <button slot="actions" class="btn btn-primary !py-2" data-modal-open="plan"><Icon name="coins" size={15} />Change plan</button>
  </PageHeader>

  <!-- ── Plan + usage hero ───────────────────────────────── -->
  <section class="grid lg:grid-cols-3 gap-4 mb-4">
    <div class="card glow-card card-tint-indigo lg:col-span-2 p-6 sm:p-7 relative overflow-hidden" data-reveal>
      <div class="bg-grid-dense opacity-30"></div>
      <div class="relative">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <div class="kpi-label">Current plan</div>
            <div class="mt-1 flex items-center gap-3">
              <span class="text-[clamp(2rem,4vw,2.6rem)] font-bold leading-none tracking-[-0.04em] text-ink-primary">{plan.name}</span>
              <span class="dbadge dbadge-accent">Active</span>
            </div>
            <p class="mt-2 text-ink-secondary text-[0.9rem] mono">{billing.priceLabel}</p>
          </div>
          <div class="text-right">
            <div class="kpi-label">Cycle resets in</div>
            <div class="mt-1 text-2xl font-bold tnum text-ink-primary">{billing.cycleResetsIn}</div>
          </div>
        </div>

        <!-- token-budget meter -->
        <div class="mt-6">
          <div class="flex items-end justify-between mb-1.5">
            <span class="text-sm text-ink-secondary">Token budget used this cycle</span>
            <span class="text-sm mono text-ink-primary tnum">{usageLabel}</span>
          </div>
          <div class={`prog ${usageProgClass}`}><span style={`width:${Math.min(100, usagePct)}%`}></span></div>
          <div class="mt-1.5 text-2xs text-ink-muted">
            {pct(usagePct)} of your {plan.name} budget. Hit the cap and calls pause until next cycle — or upgrade for a bigger budget. No surprise overage charges.
          </div>
        </div>

        <!-- flat fee + remaining -->
        <div class="mt-6 grid grid-cols-2 gap-3">
          <div class="rounded-xl bg-bg-2/60 border border-border p-4">
            <div class="kpi-label">Monthly fee</div>
            <div class="mt-1 text-2xl font-bold tnum text-ink-primary" data-bind="billing.monthlyFeeEur" data-fmt="eur">{eur(billing.monthlyFeeEur)}</div>
            <div class="text-2xs text-ink-muted mt-1">Flat — same every cycle</div>
          </div>
          <div class="rounded-xl bg-bg-2/60 border border-border p-4">
            <div class="kpi-label">Tokens remaining</div>
            <div class="mt-1 text-2xl font-bold tnum text-accent">{tokensRemaining === null ? "Unlimited" : compact(tokensRemaining)}</div>
            <div class="text-2xs text-ink-muted mt-1">Before this cycle's cap</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Pays-for-itself panel -->
    <div class="card card-tint-orange p-6 flex flex-col" data-reveal>
      <div class="kpi-label">Plynf pays for itself</div>
      <div class="mt-3">
        <div class="text-[clamp(2.2rem,5vw,3rem)] font-bold leading-none tracking-[-0.04em] text-accent tnum">{eur(savingsTotals.savedMonthEur)}</div>
        <div class="text-sm text-ink-secondary mt-2">saved this month vs. running your agents without Plynf.</div>
      </div>
      <div class="mt-5 rounded-xl bg-bg-2/60 border border-border p-4">
        <div class="flex items-baseline justify-between">
          <span class="text-sm text-ink-secondary">Saved</span>
          <span class="mono text-accent">{eur(savingsTotals.savedMonthEur)}</span>
        </div>
        <div class="flex items-baseline justify-between mt-1">
          <span class="text-sm text-ink-secondary">You pay</span>
          <span class="mono text-ink-primary">{eur(billing.monthlyFeeEur)}</span>
        </div>
        <div class="prog prog-ok mt-3"><span style={`width:${Math.min(100, (billing.monthlyFeeEur / savingsTotals.savedMonthEur) * 100)}%`}></span></div>
        <div class="text-2xs text-ink-muted mt-2">
          Every €1 of your fee returns about <span class="text-ink-primary mono">{coverageX.toFixed(0)}×</span> in saved model spend.
        </div>
      </div>
      <a href="/app/economics" class="btn btn-ghost !py-2 mt-auto pt-4 text-sm">See the full savings report →</a>
    </div>
  </section>

  <!-- ── What your plan includes — the gate, made visible ── -->
  <section class="card p-5 sm:p-6 mb-4" data-reveal>
    <div class="flex flex-wrap items-center justify-between gap-2 mb-1">
      <h3 class="font-semibold text-ink-primary">What your {plan.name} plan unlocks</h3>
      <a href="/pricing" class="text-2xs text-accent hover:underline">Compare all plans →</a>
    </div>
    <p class="text-sm text-ink-secondary mb-4 max-w-2xl">Features are gated by plan — this mirrors exactly what the proxy enforces. Locked rows show the tier that unlocks them, so nothing surprises you mid-integration.</p>
    <div class="grid sm:grid-cols-2 gap-2.5">
      {gatedFeatures.map((f) => {
        const need = f.gate!.minTier;
        const allowed = PLANS.findIndex((p) => p.id === tier) >= PLANS.findIndex((p) => p.id === need);
        return (
          <div class={`flex items-center gap-3 rounded-xl border p-3.5 ${allowed ? "border-border bg-bg-1/40" : "border-border/60 bg-bg-1/20"}`}>
            <span class={`grid place-items-center h-7 w-7 rounded-lg flex-none ${allowed ? "text-[#2dd4a7] bg-[#2dd4a7]/10" : "text-ink-muted bg-bg-2"}`}>
              <Icon name={allowed ? "check" : "shield"} size={15} />
            </span>
            <div class="min-w-0 flex-1">
              <div class={`text-sm ${allowed ? "text-ink-primary" : "text-ink-secondary"}`}>{f.label}</div>
              <div class="text-2xs text-ink-muted">{f.values[tier]}</div>
            </div>
            {!allowed && (
              <a href="/pricing" class="dbadge !text-[0.6rem] whitespace-nowrap inline-flex items-center gap-1" title={`Unlocks on ${planFor(need).name}`}>
                <Icon name="shield" size={10} />{planFor(need).name}
              </a>
            )}
          </div>
        );
      })}
    </div>
  </section>

  <!-- ── KPI row ─────────────────────────────────────────── -->
  <section class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
    <Kpi label="Monthly fee" value={eur(billing.monthlyFeeEur)} sub="Flat — no overage" tint="indigo" bind="billing.monthlyFeeEur" bindFmt="eur" />
    <Kpi label="Saved this month" value={eur(savingsTotals.savedMonthEur)} sub="Plynf more than pays for itself" tint="orange" />
    <Kpi label="Token budget used" value={pct(usagePct)} sub={`${compact(used)} of ${budget ? compact(budget) : "∞"}`} tint="cyan" />
    <Kpi label="Plan" value={plan.name} sub={`${tokenRow ? tokenRow.values[tier] : ""} / mo`} tint="magenta" />
  </section>

  <!-- ── Invoices + payment method ───────────────────────── -->
  <section class="grid lg:grid-cols-3 gap-4">
    <div class="card p-5 lg:col-span-2" data-reveal>
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-semibold text-ink-primary">Invoices</h3>
        <span class="text-2xs mono text-ink-muted">{billing.invoices.length} on file</span>
      </div>
      <div class="overflow-x-auto -mx-1">
        <table class="dtable">
          <thead>
            <tr>
              <th>Period</th>
              <th class="num">Amount</th>
              <th>Status</th>
              <th class="num">Invoice</th>
            </tr>
          </thead>
          <tbody id="invoices-body">
            {billing.invoices.map((inv) => (
              <tr>
                <td class="strong">{inv.period}</td>
                <td class="num strong tnum">{eur(inv.amountEur)}</td>
                <td><StatusBadge status={inv.status} /></td>
                <td class="num">
                  <button type="button" class="btn btn-ghost !py-1 !px-2 text-2xs inline-flex items-center gap-1.5" aria-label={`Download invoice for ${inv.period}`} data-action={`Downloading invoice ${inv.period}`}>
                    <Icon name="download" size={13} />Download
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="card p-5" data-reveal>
      <h3 class="font-semibold text-ink-primary mb-3">Payment method</h3>
      <div class="rounded-xl border border-border bg-bg-1/40 p-4 flex items-center gap-3">
        <div class="grid place-items-center w-10 h-10 rounded-lg bg-bg-2 border border-border text-ink-secondary">
          <Icon name="card" size={18} />
        </div>
        <div class="min-w-0">
          <div class="text-sm text-ink-primary truncate">{billing.paymentMethod}</div>
          <div class="text-2xs text-ink-muted mt-0.5">Charged automatically at cycle close</div>
        </div>
      </div>
      <button type="button" class="btn btn-secondary !py-2 w-full mt-4" data-modal-open="pay"><Icon name="edit" size={14} />Update</button>
      <p class="text-2xs text-ink-muted mt-3">
        Next charge of <span class="text-ink-primary mono">{eur(billing.monthlyFeeEur)}</span> in {billing.cycleResetsIn}.
      </p>
    </div>
  </section>

  <!-- ── Modals ──────────────────────────────────────────── -->
  <!-- Change plan -->
  <div slot="modals" class="modal-backdrop" id="modal-plan">
    <div class="modal" role="dialog" aria-modal="true" aria-label="Change plan">
      <div class="modal-head">
        <div>
          <h3 class="font-semibold text-ink-primary text-lg">Change your plan</h3>
          <p class="text-sm text-ink-muted mt-0.5">One flat price per tier. The plan sets your monthly token budget and which features are unlocked.</p>
        </div>
        <button class="btn btn-ghost !p-1.5" data-modal-close aria-label="Close"><Icon name="plus" size={18} class="rotate-45" /></button>
      </div>
      <form class="modal-body space-y-3.5" data-action="Plan updated" data-close-modal="plan">
        <fieldset class="grid sm:grid-cols-3 gap-3">
          <legend class="sr-only">Plan tier</legend>
          {PLANS.map((p) => (
            <label class="plan-tile rounded-xl border border-border bg-bg-1/40 p-4 cursor-pointer block transition has-[:checked]:border-accent has-[:checked]:bg-bg-2/60">
              <span class="flex items-center justify-between">
                <span class="text-sm font-medium text-ink-primary">{p.name}</span>
                <input type="radio" name="plan-tier" value={p.id} class="accent-[var(--accent)]" checked={p.id === tier} required />
              </span>
              <span class="block text-lg font-bold tnum text-ink-primary mt-2">{p.price}</span>
              <span class="block mono text-2xs text-ink-muted mt-0.5">/ {p.cadence}</span>
              <span class="block text-2xs text-ink-secondary mt-2">{tokenRow ? tokenRow.values[p.id] : ""} tokens / mo</span>
              <span class="block text-2xs text-ink-muted mt-0.5">{p.id === tier ? "Current plan" : p.blurb}</span>
            </label>
          ))}
        </fieldset>
        <div class="modal-foot !px-0 !pb-0">
          <button type="button" class="btn btn-secondary" data-modal-close>Cancel</button>
          <button type="submit" class="btn btn-primary">Confirm plan change</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Update payment method -->
  <div slot="modals" class="modal-backdrop" id="modal-pay">
    <div class="modal" role="dialog" aria-modal="true" aria-label="Update payment method">
      <div class="modal-head">
        <div>
          <h3 class="font-semibold text-ink-primary text-lg">Update payment method</h3>
          <p class="text-sm text-ink-muted mt-0.5">Card details are sent straight to our processor and never stored on Plynf.</p>
        </div>
        <button class="btn btn-ghost !p-1.5" data-modal-close aria-label="Close"><Icon name="plus" size={18} class="rotate-45" /></button>
      </div>
      <form class="modal-body space-y-3.5" data-action="Payment method updated" data-close-modal="pay">
        <div>
          <label class="dlabel" for="pay-card">Card number</label>
          <input id="pay-card" class="dinput mono" inputmode="numeric" autocomplete="cc-number" placeholder="4242 4242 4242 4242" required />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="dlabel" for="pay-exp">Expiry</label>
            <input id="pay-exp" class="dinput mono" inputmode="numeric" autocomplete="cc-exp" placeholder="MM / YY" required />
          </div>
          <div>
            <label class="dlabel" for="pay-cvc">CVC</label>
            <input id="pay-cvc" class="dinput mono" inputmode="numeric" autocomplete="cc-csc" placeholder="123" required />
          </div>
        </div>
        <div>
          <label class="dlabel" for="pay-name">Name on card</label>
          <input id="pay-name" class="dinput" autocomplete="cc-name" placeholder="Lena Hofer" />
        </div>
        <div class="modal-foot !px-0 !pb-0">
          <button type="button" class="btn btn-secondary" data-modal-close>Cancel</button>
          <button type="submit" class="btn btn-primary">Save card</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Budget alert -->
  <div slot="modals" class="modal-backdrop" id="modal-budget">
    <div class="modal" role="dialog" aria-modal="true" aria-label="Set budget alert">
      <div class="modal-head">
        <div>
          <h3 class="font-semibold text-ink-primary text-lg">Set a budget alert</h3>
          <p class="text-sm text-ink-muted mt-0.5">We'll notify you before you reach your monthly token budget — so calls never pause unexpectedly.</p>
        </div>
        <button class="btn btn-ghost !p-1.5" data-modal-close aria-label="Close"><Icon name="plus" size={18} class="rotate-45" /></button>
      </div>
      <form class="modal-body space-y-3.5" data-action="Budget alert saved" data-close-modal="budget">
        <div class="flex items-center justify-between rounded-xl border border-border bg-bg-1/40 px-3.5 py-2.5">
          <div class="min-w-0">
            <div class="text-sm text-ink-primary">Enable budget alerts</div>
            <div class="text-2xs text-ink-muted mt-0.5">Email the account owner when the threshold is reached.</div>
          </div>
          <span class="toggle" role="switch" aria-checked="true" tabindex="0" data-label="Budget alerts" aria-label="Toggle budget alerts"></span>
        </div>
        <div>
          <label class="dlabel" for="budget-amount">Alert at % of token budget</label>
          <input id="budget-amount" class="dinput mono" inputmode="numeric" placeholder="80" value="80" required />
          <p class="text-2xs text-ink-muted mt-1.5">You're at <span class="text-ink-primary mono">{pct(usagePct)}</span> of your {plan.name} budget this cycle.</p>
        </div>
        <div class="modal-foot !px-0 !pb-0">
          <button type="button" class="btn btn-secondary" data-modal-close>Cancel</button>
          <button type="submit" class="btn btn-primary">Save alert</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Live invoices table from GET /api/app/state (SSG rows are the fallback). -->
  <script is:inline>
    (function () {
      function render(state) {
        var inv = state && state.billing && state.billing.invoices;
        var body = document.getElementById("invoices-body");
        if (!body || !inv || !window.plynfUI) return;
        var ui = window.plynfUI, fmt = window.plynfFmt;
        body.innerHTML = inv.map(function (i) {
          return '<tr><td class="strong">' + ui.esc(i.period) + "</td>" +
            '<td class="num strong tnum">' + fmt.eur(i.amountEur) + "</td>" +
            "<td>" + ui.statusBadge(i.status) + "</td>" +
            '<td class="num"><button type="button" class="btn btn-ghost !py-1 !px-2 text-2xs" data-action="Downloading invoice ' + ui.esc(i.period) + '">Download</button></td></tr>';
        }).join("");
      }
      if (window.__PLYNF_LIVE) render(window.__PLYNF_LIVE);
      window.addEventListener("plynf:state", function (e) { render(e.detail); });
    })();
  </script>
</DashboardLayout>
