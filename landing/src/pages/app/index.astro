---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import PageHeader from "../../components/dashboard/PageHeader.astro";
import Kpi from "../../components/dashboard/Kpi.astro";
import StatusBadge from "../../components/dashboard/StatusBadge.astro";
import Icon from "../../components/dashboard/Icon.astro";
import { kpis, agents, workflows, eur, pct, compact, num } from "../../data/dashboard";

const active = workflows.filter((w) => w.status === "running" || w.status === "recovered" || w.status === "queued");
const attention = agents.filter((a) => a.status === "down" || a.status === "degraded" || a.dlq > 0);
const ampel = {
  healthy: agents.filter((a) => a.status === "healthy").length,
  degraded: agents.filter((a) => a.status === "degraded").length,
  down: agents.filter((a) => a.status === "down").length,
  paused: agents.filter((a) => a.status === "paused").length,
};
---
<DashboardLayout title="Overview" active="/app">
  <PageHeader
    kicker="Good afternoon, Lena"
    title="Everything Plynf did for you today"
    lead="A single glance: are your agents healthy, what did they cost, and how much did Plynf save you — right now."
  >
    <a slot="actions" href="/app/agents" class="btn btn-secondary !py-2">View agents</a>
    <a slot="actions" href="/app/economics" class="btn btn-primary !py-2">Savings report</a>
  </PageHeader>

  <!-- ── Hero: today's savings ─────────────────────────── -->
  <section class="grid lg:grid-cols-3 gap-4 mb-4">
    <div class="card glow-card card-tint-orange lg:col-span-2 p-6 sm:p-7 relative overflow-hidden" data-reveal>
      <div class="bg-grid-dense opacity-30"></div>
      <div class="relative flex flex-wrap items-start justify-between gap-6">
        <div>
          <div class="kpi-label">Token reduction today · with vs. without Plynf</div>
          <div class="mt-2 flex items-end gap-3">
            <span class="text-[clamp(3rem,7vw,5rem)] font-bold leading-none tracking-[-0.05em] text-ink-primary" data-bind="kpis.reductionPct" data-fmt="pct">{pct(kpis.reductionPct)}</span>
            <span class="dbadge dbadge-ok mb-3"><Icon name="arrowup" size={12} />2.1 pts vs. last week</span>
          </div>
          <p class="mt-3 text-ink-secondary max-w-md text-[0.95rem]">
            Plynf shaped <span class="text-ink-primary mono" data-bind="kpis.savedTokensToday" data-fmt="compact">{compact(kpis.savedTokensToday)}</span> tokens out of your
            agents' tool responses before they ever hit a model — that's
            <span class="text-accent font-medium" data-bind="kpis.savedTodayEur" data-fmt="eur">{eur(kpis.savedTodayEur)}</span> saved today alone.
          </p>
        </div>

        <!-- comparison bars -->
        <div class="w-full sm:w-64 space-y-3">
          <div>
            <div class="flex justify-between text-2xs mono text-ink-muted mb-1"><span>WITHOUT PLYNF</span><span>{eur(kpis.costWithoutTodayEur)}</span></div>
            <div class="prog prog-bad"><span style="width:100%"></span></div>
          </div>
          <div>
            <div class="flex justify-between text-2xs mono text-ink-muted mb-1"><span>WITH PLYNF</span><span class="text-accent">{eur(kpis.costTodayEur)}</span></div>
            <div class="prog"><span style={`width:${(kpis.costTodayEur / kpis.costWithoutTodayEur) * 100}%`}></span></div>
          </div>
          <div class="pt-1 text-center" data-depth="finance-only">
            <div class="kpi-label">Saved this month</div>
            <div class="text-2xl font-bold text-accent tnum">{eur(kpis.savedMonthEur)}</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Fleet ampel -->
    <div class="card p-6" data-reveal>
      <div class="flex items-center justify-between">
        <span class="kpi-label">Fleet status</span>
        <a href="/app/agents" class="text-2xs mono text-ink-muted hover:text-ink-primary">{kpis.activeAgents}/{kpis.totalAgents} live →</a>
      </div>
      <div class="mt-4 grid grid-cols-2 gap-3">
        <div class="rounded-xl bg-bg-2/60 border border-border p-3">
          <div class="flex items-center gap-2"><span class="dot dot-healthy"></span><span class="text-2xl font-bold tnum text-ink-primary">{ampel.healthy}</span></div>
          <div class="text-2xs text-ink-muted mt-1">Healthy</div>
        </div>
        <div class="rounded-xl bg-bg-2/60 border border-border p-3">
          <div class="flex items-center gap-2"><span class="dot dot-degraded"></span><span class="text-2xl font-bold tnum text-ink-primary">{ampel.degraded}</span></div>
          <div class="text-2xs text-ink-muted mt-1">Degraded</div>
        </div>
        <div class="rounded-xl bg-bg-2/60 border border-border p-3">
          <div class="flex items-center gap-2"><span class="dot dot-down"></span><span class="text-2xl font-bold tnum text-ink-primary">{ampel.down}</span></div>
          <div class="text-2xs text-ink-muted mt-1">Down</div>
        </div>
        <div class="rounded-xl bg-bg-2/60 border border-border p-3">
          <div class="flex items-center gap-2"><span class="dot dot-paused"></span><span class="text-2xl font-bold tnum text-ink-primary">{ampel.paused}</span></div>
          <div class="text-2xs text-ink-muted mt-1">Paused</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── KPI row ─────────────────────────────────────────── -->
  <section class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
    <Kpi label="Spend today" value={eur(kpis.costTodayEur)} sub={`vs ${eur(kpis.costWithoutTodayEur)} without Plynf`} tint="orange" trend={-28.0} trendGood="down" bind="kpis.costTodayEur" bindFmt="eur" />
    <Kpi label="Tokens saved today" value={compact(kpis.savedTokensToday)} sub={`of ${compact(kpis.rawTokensToday)} raw`} tint="magenta" depth="technical" bind="kpis.savedTokensToday" bindFmt="compact" />
    <Kpi label="Active workflows" value={String(kpis.activeWorkflows)} sub={`${num(kpis.toolCallsToday)} tool calls today`} tint="indigo" bind="kpis.activeWorkflows" bindFmt="num" />
    <Kpi label="Cache hit rate" value={pct(kpis.cacheHitRate)} sub="served without a tool round-trip" tint="cyan" depth="technical" bind="kpis.cacheHitRate" bindFmt="pct" />
  </section>

  <!-- ── Active workflows + needs-attention ──────────────── -->
  <section class="grid lg:grid-cols-3 gap-4">
    <div class="card p-5 lg:col-span-2" data-reveal>
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-semibold text-ink-primary">Active workflows</h3>
        <a href="/app/agents" class="text-sm text-ink-secondary hover:text-ink-primary">All workflows →</a>
      </div>
      <div class="space-y-2">
        {active.map((w) => (
          <a href="/app/agents" class="flex items-center gap-4 rounded-xl border border-border bg-bg-1/40 px-4 py-3 hover:border-accent/30 transition-colors">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <span class="text-[0.9rem] text-ink-primary truncate">{w.name}</span>
                <StatusBadge status={w.status} />
              </div>
              <div class="text-2xs text-ink-muted mt-0.5">{w.agent} · started {w.startedAgo}{w.recoveredFrom ? ` · resumed from “${w.recoveredFrom}”` : ""}</div>
            </div>
            <div class="w-28 hidden sm:block">
              <div class={`prog ${w.status === "recovered" ? "prog-warn" : ""}`}><span style={`width:${w.progress}%`}></span></div>
              <div class="text-2xs text-ink-muted mt-1 text-right tnum">{w.progress}%</div>
            </div>
            <Icon name="chevronr" size={16} />
          </a>
        ))}
      </div>
    </div>

    <div class="card p-5" data-reveal data-depth="technical">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-semibold text-ink-primary">Needs attention</h3>
        {kpis.dlqCount > 0 && <span class="dbadge dbadge-bad">{kpis.dlqCount} in DLQ</span>}
      </div>
      <div class="space-y-2">
        {attention.length === 0 && <p class="text-sm text-ink-muted">All clear — nothing needs you.</p>}
        {attention.map((a) => (
          <div class="flex items-center gap-3 rounded-xl border border-border bg-bg-1/40 px-3.5 py-3">
            <span class={`dot ${a.status === "down" ? "dot-down" : "dot-degraded"}`}></span>
            <div class="min-w-0 flex-1">
              <div class="text-[0.88rem] text-ink-primary truncate">{a.name}</div>
              <div class="text-2xs text-ink-muted">
                {a.status === "down" ? "Process down" : `${pct(a.errorRatePct)} error rate`}
                {a.dlq > 0 ? ` · ${a.dlq} dead-lettered` : ""}
              </div>
            </div>
            <a href="/app/agents" class="btn btn-ghost !py-1 !px-2 text-2xs">Inspect</a>
          </div>
        ))}
      </div>
      <a href="/app/gateway" class="mt-4 flex items-center justify-between rounded-xl border border-border px-3.5 py-3 hover:border-accent/30 transition-colors">
        <span class="text-sm text-ink-secondary">Tool gateway audit log</span>
        <Icon name="chevronr" size={15} />
      </a>
    </div>
  </section>
</DashboardLayout>
