---
import BaseLayout from "../layouts/BaseLayout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
// Control-plane API that mints the dashboard session JWT (via identity).
const apiBase = import.meta.env.PUBLIC_PLYNF_API || "http://localhost:7424";
---
<BaseLayout
  title="Log in"
  description="Sign in to the Plynf dashboard — your agents' control & monitoring surface."
>
  <main id="main" class="min-h-screen grid lg:grid-cols-2" data-api={apiBase}>
    <!-- ── Brand / value panel ─────────────────────────── -->
    <section class="relative hidden lg:flex flex-col justify-between overflow-hidden p-12 border-r border-border">
      <div class="bg-hero-glow opacity-[0.16]"></div>
      <div class="bg-grid"></div>
      <a href="/" class="relative flex items-center gap-2.5" aria-label="Plynf home">
        <span class="relative flex h-8 w-8 items-center justify-center rounded-lg bg-bg-2 border border-border">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <defs>
              <linearGradient id="login-rock" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#ff8551" /><stop offset="50%" stop-color="#d946ef" /><stop offset="100%" stop-color="#6366f1" />
              </linearGradient>
            </defs>
            <path d="M5 17 L8 9 L12 6 L17 6 L20 11 L20 17 Z" fill="url(#login-rock)" stroke="#1d1f29" stroke-width="0.6" stroke-linejoin="round" />
          </svg>
        </span>
        <span class="font-semibold tracking-tight text-ink-primary text-lg">Plynf</span>
      </a>

      <div class="relative max-w-md">
        <div class="eyebrow mb-5"><span class="eyebrow-dot"></span>Control &amp; monitoring</div>
        <h1 class="text-display-sm font-bold tracking-tightest text-ink-primary">
          Every agent. Every token. <span class="gradient-text-accent">One screen.</span>
        </h1>
        <p class="mt-4 text-ink-secondary leading-relaxed">
          Live fleet status, plain-language summaries of what your agents did, and the
          number that matters most — <span class="text-accent font-medium">71.8% fewer tokens</span>,
          billed.
        </p>
        <dl class="mt-8 grid grid-cols-3 gap-4">
          <div><dt class="text-2xs mono uppercase tracking-wider text-ink-muted">Saved / mo</dt><dd class="text-2xl font-bold text-ink-primary tnum">€2.4k</dd></div>
          <div><dt class="text-2xs mono uppercase tracking-wider text-ink-muted">Reduction</dt><dd class="text-2xl font-bold text-ink-primary tnum">71.8%</dd></div>
          <div><dt class="text-2xs mono uppercase tracking-wider text-ink-muted">Uptime</dt><dd class="text-2xl font-bold text-ink-primary tnum">99.9%</dd></div>
        </dl>
      </div>

      <p class="relative text-2xs text-ink-muted mono">SOC 2-ready · GDPR · tamper-evident audit logs</p>
    </section>

    <!-- ── Auth panel ──────────────────────────────────── -->
    <section class="relative flex flex-col">
      <div class="flex items-center justify-between p-5">
        <a href="/" class="lg:hidden flex items-center gap-2 text-ink-secondary hover:text-ink-primary text-sm">← Back</a>
        <span class="hidden lg:block"></span>
        <ThemeToggle />
      </div>

      <div class="flex-1 flex items-center justify-center px-6 pb-16">
        <div class="w-full max-w-sm">
          <h2 class="text-2xl font-bold tracking-tight text-ink-primary">Sign in to your dashboard</h2>
          <p class="mt-2 text-sm text-ink-secondary">No passwords. Plynf uses single sign-on and magic links.</p>

          <!-- SSO / OAuth -->
          <div class="mt-7 space-y-2.5" id="sso">
            <button class="btn btn-secondary w-full !justify-start gap-3 !py-3" data-provider="github">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.79-.26.79-.58v-2c-3.34.73-4.04-1.61-4.04-1.61-.55-1.38-1.34-1.75-1.34-1.75-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.23 1.84 1.23 1.07 1.83 2.81 1.3 3.5.99.11-.77.42-1.3.76-1.6-2.66-.3-5.46-1.33-5.46-5.93 0-1.31.47-2.38 1.23-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 016 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.19.69.8.58A12 12 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
              <span>Continue with GitHub</span>
            </button>
            <button class="btn btn-secondary w-full !justify-start gap-3 !py-3" data-provider="google">
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.7-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.8z"/><path fill="#34A853" d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-3.9-3c-1.1.7-2.5 1.2-4 1.2-3.1 0-5.7-2.1-6.6-4.9H1.4v3.1C3.4 21.3 7.4 24 12 24z"/><path fill="#FBBC05" d="M5.4 14.4c-.2-.7-.4-1.4-.4-2.4s.1-1.6.4-2.4V6.5H1.4C.5 8.2 0 10 0 12s.5 3.8 1.4 5.5l4-3.1z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4C17.9 1.2 15.2 0 12 0 7.4 0 3.4 2.7 1.4 6.5l4 3.1C6.3 6.8 8.9 4.8 12 4.8z"/></svg>
              <span>Continue with Google</span>
            </button>
            <button class="btn btn-secondary w-full !justify-start gap-3 !py-3" data-provider="sso">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <span>Continue with SSO (SAML)</span>
            </button>
          </div>

          <div class="my-6 flex items-center gap-3 text-2xs uppercase tracking-wider text-ink-muted mono">
            <span class="h-px flex-1 bg-border"></span>or<span class="h-px flex-1 bg-border"></span>
          </div>

          <!-- Magic link -->
          <form id="magic-form" class="space-y-3">
            <label class="block">
              <span class="text-2xs mono uppercase tracking-wider text-ink-muted">Work email</span>
              <input
                type="email" name="email" required placeholder="you@company.com" autocomplete="email"
                class="mt-1.5 w-full rounded-xl bg-bg-1 border border-border-strong px-3.5 py-2.5 text-ink-primary placeholder:text-ink-muted outline-none focus:border-accent focus:ring-2 focus:ring-accent/30 transition"
              />
            </label>
            <button type="submit" class="btn btn-primary w-full !py-3">Send magic link</button>
          </form>

          <div id="magic-sent" class="hidden mt-4 rounded-xl border border-border bg-bg-1 p-4 text-sm text-ink-secondary">
            <div class="flex items-center gap-2 text-ink-primary font-medium mb-1">
              <span class="dot dot-healthy !w-2 !h-2"></span> Check your inbox
            </div>
            We sent a sign-in link to <span id="magic-email" class="text-ink-primary mono"></span>. It expires in 15 minutes.
            <button id="magic-demo" class="mt-3 btn btn-secondary w-full !py-2 text-sm">Open dashboard (demo)</button>
          </div>

          <p class="mt-7 text-2xs text-ink-muted leading-relaxed">
            By continuing you agree to the <a href="/terms" class="underline hover:text-ink-secondary">Terms</a>
            and <a href="/privacy" class="underline hover:text-ink-secondary">Privacy Policy</a>.
            Tokens are exchanged via the Plynf OAuth broker and never persisted in transit.
          </p>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      // Demo auth: in production each button hits /v1/oauth/start on the broker
      // and the dashboard origin receives the token in the URL fragment. Here we
      // mint a demo session and redirect, preserving ?next=.
      var params = new URLSearchParams(location.search);
      var next = params.get("next") || "/app";
      // basic open-redirect guard: only allow same-origin app paths
      if (!next.startsWith("/app")) next = "/app";
      var API = (document.getElementById("main").getAttribute("data-api") || "").replace(/\/$/, "");
      // Partner attribution: capture ?ref= and remember it across the auth bounce.
      var ref = (params.get("ref") || "").slice(0, 64);
      try {
        if (ref) localStorage.setItem("plynf_ref", ref);
        else ref = localStorage.getItem("plynf_ref") || "";
      } catch (_) {}

      // Exchange the completed SSO/magic-link for a real session JWT minted by
      // the identity service (POST /api/app/session). Stored as plynf_session
      // and sent as a Bearer on every /api/app/* call. Falls back to a demo
      // token if the control-plane API is unreachable so the offline demo works.
      function signIn(provider, email) {
        fetch(API + "/api/app/session", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ provider: provider, email: email || "", ref: ref || undefined }),
        })
          .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
          .then(function (d) {
            if (!d || !d.token) throw new Error("no token");
            try { localStorage.setItem("plynf_session", d.token); localStorage.removeItem("plynf_ref"); } catch (_) {}
            window.location.href = next;
          })
          .catch(function () {
            try { localStorage.setItem("plynf_session", "demo-" + provider); } catch (_) {}
            window.location.href = next;
          });
      }

      document.querySelectorAll("#sso button[data-provider]").forEach(function (b) {
        b.addEventListener("click", function () {
          b.setAttribute("aria-busy", "true");
          b.querySelector("span").textContent = "Signing in…";
          signIn(b.getAttribute("data-provider"));
        });
      });

      var form = document.getElementById("magic-form");
      var sent = document.getElementById("magic-sent");
      form && form.addEventListener("submit", function (e) {
        e.preventDefault();
        var email = (new FormData(form)).get("email");
        document.getElementById("magic-email").textContent = email;
        form.classList.add("hidden");
        sent.classList.remove("hidden");
      });
      var demo = document.getElementById("magic-demo");
      demo && demo.addEventListener("click", function () {
        var email = (new FormData(form)).get("email");
        signIn("magic", email);
      });
    })();
  </script>
</BaseLayout>
