# Plynf production stack — copy this to deploy/.env and fill in your values.
#
#   cp deploy/prod.env.example deploy/.env      # then edit deploy/.env
#   docker compose -f deploy/compose.prod.yml pull
#   docker compose -f deploy/compose.prod.yml up -d --wait
#
# docker compose auto-loads deploy/.env (same directory as the compose file).
# Never commit a real .env — it holds your model key and tenant secrets.

# ── Image coordinates ───────────────────────────────────────────────────────
PLYNF_ORG=plynf
PLYNF_VERSION=latest

# ── Edge / TLS ───────────────────────────────────────────────────────────────
# The domain Caddy serves, and the email Let's Encrypt ties your certs to.
# Point this domain's A record at the host BEFORE bringing the stack up.
PLYNF_APP_DOMAIN=app.plynf.com
PLYNF_ACME_EMAIL=you@yourcompany.com

# ── Proxy → real model ───────────────────────────────────────────────────────
# Leave DEMO_MODE=true to boot in safe mock mode (no key needed). Flip to
# false and set the two UPSTREAM_* vars to forward to a real model.
PLINTH_PROXY_DEMO_MODE=false
PLINTH_PROXY_UPSTREAM_BASE_URL=https://api.openai.com
PLINTH_PROXY_UPSTREAM_API_KEY=sk-replace-with-your-openai-key

# Tenant keys the proxy accepts — format tenant:key:tier (comma-separated).
# Generate one per GO_LIVE.md step 3:
#   echo "acme:plynf_sk_live_$(openssl rand -hex 24):enterprise"
PLINTH_PROXY_API_KEYS=acme:plynf_sk_live_replace_me:enterprise

# Host port the proxy publishes on. Kept off 7430 because google-mcp owns it.
PLINTH_PROXY_PORT=7434

# ── Self-serve accounts + Stripe (the zero-terminal customer flow) ──────────
# Shared secret between proxy and dashboard for customer-key resolution.
# Generate once:  openssl rand -hex 32
PLINTH_INTERNAL_SECRET=replace-with-openssl-rand-hex-32
# Public site origin (checkout success/cancel + portal return URLs).
PLINTH_SITE_URL=https://plynf.com
# Stripe: create two recurring Prices (Pro $49/mo, Enterprise custom) in the
# Stripe dashboard, then add a webhook endpoint pointed at
#   https://app.plynf.com/api/stripe/webhook
# with events: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted. Leave all four empty to run SIMULATED
# billing (full flow, no charge) — fine for a staging boot, never for prod.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ── Dashboard control plane ──────────────────────────────────────────────────
# Require a JWT on /api/app/* in production (false boots the open demo).
PLINTH_DASHBOARD_APP_AUTH_REQUIRED=true
# Origins allowed to call the dashboard API — your site + the API host.
PLINTH_DASHBOARD_CORS_ORIGINS=https://plynf.com,https://app.plynf.com

# ── Outbound email (verification + password-reset links) ─────────────────────
# Leave PLINTH_SMTP_HOST empty to use the console mailer: each link is written
# to the dashboard log instead of sent — fine for a staging boot, not for prod.
# Set the host (+ port/credentials) to deliver real mail via SMTP.
PLINTH_SMTP_HOST=
PLINTH_SMTP_PORT=587
PLINTH_SMTP_USERNAME=
PLINTH_SMTP_PASSWORD=
PLINTH_SMTP_USE_TLS=true
PLINTH_EMAIL_FROM=Plynf <noreply@plynf.com>
# Payment receipts are NOT sent by Plynf — Stripe emails a branded receipt +
# invoice PDF natively. Turn on "Email customers about successful payments" in
# the Stripe dashboard (Settings → Customer emails). SMTP above is only for the
# verification + password-reset links.

# ── Savings persistence (Postgres) ───────────────────────────────────────────
# The proxy writes savings events here so the dashboard's token/cost totals
# survive restarts. CHANGE THE PASSWORD — and keep it identical in both
# POSTGRES_PASSWORD and the URL below. Set PLINTH_PROXY_POSTGRES_URL empty to
# fall back to ephemeral /tmp JSONL instead.
POSTGRES_USER=plynf
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=plynf
PLINTH_PROXY_POSTGRES_URL=postgresql://plynf:change-me-in-prod@postgres:5432/plynf
# Customer accounts live in the same Postgres (table `accounts`, durable +
# pg_dump-able). Use the SAME password as above. Set empty to fall back to a
# JSON file on the dashboard volume instead.
PLINTH_DASHBOARD_ACCOUNTS_DB_URL=postgresql://plynf:change-me-in-prod@postgres:5432/plynf
